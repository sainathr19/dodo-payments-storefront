# false switches the app from fixtures to the Rust backend
EXPO_PUBLIC_USE_FIXTURES=false
# The simulator resolves localhost; a physical device needs the tunnel URL.
EXPO_PUBLIC_API_URL=http://localhost:8080
# Comma-separated customer ids from backend/seed.json
EXPO_PUBLIC_CUSTOMER_IDS=cus_example_0,cus_example_1,cus_example_2
